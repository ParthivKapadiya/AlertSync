@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="page-head">
    <div>
        <h1>Change password</h1>
        <p>Current password, new password, and confirmation. Nothing is stored in this submission.</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Index">Cancel</a>
</div>
<form class="panel" method="post" style="max-width:640px;">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label" asp-for="CurrentPassword"></label>
        <input class="form-control" asp-for="CurrentPassword" />
        <span class="field-error" asp-validation-for="CurrentPassword"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="NewPassword"></label>
        <input class="form-control" asp-for="NewPassword" />
        <span class="field-error" asp-validation-for="NewPassword"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="ConfirmPassword"></label>
        <input class="form-control" asp-for="ConfirmPassword" />
        <span class="field-error" asp-validation-for="ConfirmPassword"></span>
    </div>
    <button class="btn btn-primary" type="submit">Update password</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
