@model ReminderFormViewModel
@{
    ViewData["Title"] = "Edit Reminder";
}

<div class="page-head">
    <div>
        <h1>Edit reminder</h1>
        <p>The form is filled from the sample reminder you opened.</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</div>

<form class="panel form-grid" method="post">
    @Html.AntiForgeryToken()
    <partial name="_Form" model="Model" />
    <div class="span-2 page-actions">
        <button class="btn btn-primary" type="submit">Save changes</button>
        <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@Model.Id">Back to details</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
