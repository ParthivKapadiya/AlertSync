@model IReadOnlyList<ReminderSample>
@{
    var showCompleted = ViewData["ShowCompleted"] as bool? ?? false;
}
@if (Model.Count == 0)
{
    <partial name="_EmptyState" model='("bi-inboxes", "No reminders match", "Try another search or filter, or add a new reminder.", "Add reminder", "Reminders", "Create")' />
}
else
{
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Due</th>
                    @if (showCompleted)
                    {
                        <th>Completed</th>
                    }
                    <th>Category</th>
                    <th>Priority</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><a class="row-title" asp-controller="Reminders" asp-action="Details" asp-route-id="@item.Id">@item.Title</a></td>
                        <td>@item.DueAt.ToString("dd MMM yyyy, h:mm tt")</td>
                        @if (showCompleted)
                        {
                            <td>@(item.CompletedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                        }
                        <td>@item.Category</td>
                        <td><partial name="_Badge" model="@item.Priority" /></td>
                        <td><partial name="_Badge" model="@item.Status" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
