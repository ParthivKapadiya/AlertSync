@model FamilyFormViewModel
@{
    ViewData["Title"] = "Edit Family Member";
}

<div class="page-head">
    <div>
        <h1>Edit family member</h1>
        <p>The form is filled from the sample member you opened.</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Index">Cancel</a>
</div>
<form class="panel" method="post" style="max-width:640px;">
    @Html.AntiForgeryToken()
    <partial name="_Form" />
    <button class="btn btn-primary" type="submit">Save changes</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
