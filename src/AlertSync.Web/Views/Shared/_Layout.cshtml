<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AlertSync</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <partial name="_Sidebar" />
        <div class="app-main">
            <header class="topbar">
                <div style="display:flex; align-items:center; gap:10px;">
                    <button class="icon-btn menu-btn" type="button" data-sidebar-toggle aria-label="Open menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="topbar-title">@ViewData["Title"]</div>
                </div>
                <div class="topbar-actions">
                    <a class="icon-btn" asp-controller="Notifications" asp-action="Index" aria-label="Notifications">
                        <i class="bi bi-bell"></i>
                        @if (LayoutSampleCatalog.UnreadCount > 0)
                        {
                            <span class="count">@LayoutSampleCatalog.UnreadCount</span>
                        }
                    </a>
                    <a class="user-chip" asp-controller="Profile" asp-action="Index">
                        <span class="avatar">PK</span>
                        <span>
                            <span>@LayoutSampleCatalog.DisplayName</span>
                            <small>Layout preview</small>
                        </span>
                    </a>
                </div>
            </header>
            <main class="content">
                <partial name="_Notice" />
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:16px;">
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <h2 class="h5">Please confirm</h2>
                        <p data-confirm-text class="mb-0"></p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-outline-danger">Confirm</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
