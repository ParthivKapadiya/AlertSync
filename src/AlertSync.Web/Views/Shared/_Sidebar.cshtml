@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string Active(string targetController, string targetAction, params string[] moreActions)
    {
        var actions = new[] { targetAction }.Concat(moreActions);
        return controller == targetController && actions.Contains(action) ? "is-active" : "";
    }
}
