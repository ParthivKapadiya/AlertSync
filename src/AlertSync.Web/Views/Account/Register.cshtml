@model RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Register";
}

<h2>Create an account</h2>
<p class="muted">Full name, email, and a password of at least 8 characters with a letter and a number.</p>
<form method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label" asp-for="FullName"></label>
        <input class="form-control" asp-for="FullName" />
        <span class="field-error" asp-validation-for="FullName"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Email"></label>
        <input class="form-control" asp-for="Email" />
        <span class="field-error" asp-validation-for="Email"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Password"></label>
        <input class="form-control" asp-for="Password" />
        <span class="field-error" asp-validation-for="Password"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="ConfirmPassword"></label>
        <input class="form-control" asp-for="ConfirmPassword" />
        <span class="field-error" asp-validation-for="ConfirmPassword"></span>
    </div>
    <button class="btn btn-primary w-100" type="submit">Register</button>
</form>
<p class="mt-3 mb-0"><a asp-action="Login">Already have an account? Sign in</a></p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
