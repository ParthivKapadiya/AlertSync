@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<h2>Forgot password</h2>
<p class="muted">Enter the account email. This submission does not send mail or create a reset token.</p>
<form method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label" asp-for="Email"></label>
        <input class="form-control" asp-for="Email" />
        <span class="field-error" asp-validation-for="Email"></span>
    </div>
    <button class="btn btn-primary w-100" type="submit">Continue</button>
</form>
<p class="mt-3 mb-0"><a asp-action="Login">Back to login</a></p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
